{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on Monday"],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 25,
  "ignorePaths": [
    "**/*.sops.yaml",
    "**/gotk-components.yaml",
    "**/migration/**",
    "docker/**",
    "node_modules/**",
    ".venv*/**"
  ],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)k3s/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k3s/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Python tool pins annotated with '# renovate:' in the ansible-lint workflow",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ansible-lint\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\n\\s*\\w+: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "k3s version pins annotated with '# renovate:' (upgrade Plan + Ansible bootstrap)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^k3s/infrastructure/configs/system-upgrade-controller/plan\\.yaml$/",
        "/^k3s/bootstrap/ansible/inventory/group_vars/all\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\n\\s*(?:version|k3s_version): \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "ansible-core 2.21 does not support Python 3.15 (crashes on import; PyPI lists 3.12-3.14), so hold the ansible workflow's Python below 3.15. Drop once ansible-core adds 3.15 support",
      "matchFileNames": [".github/workflows/ansible-lint.yaml"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "description": "ansible-core pin and collections move together: a collection major can raise the minimum core",
      "matchDepNames": ["ansible-core", "ansible-lint", "community.general", "ansible.posix"],
      "groupName": "ansible",
      "automerge": false
    },
    {
      "description": "Pin nx to a specific version instead of latest",
      "matchPackageNames": ["nx"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Disable updates for floating :latest tags in container images - pin these manually",
      "matchManagers": ["kubernetes", "docker-compose"],
      "matchCurrentValue": "latest",
      "enabled": false
    },
    {
      "description": "linuxserver/qbittorrent also publishes legacy Ubuntu-based tags (e.g. 20.04.1, qBittorrent 4.3.9); only follow real 5.x releases",
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "allowedVersions": "/^5\\./"
    },
    {
      "description": "One branch per k3s folder name so a service can be merged and reverted alone",
      "matchFileNames": ["k3s/applications/**", "k3s/infrastructure/**"],
      "groupName": "k3s-workloads",
      "additionalBranchPrefix": "{{parentDir}}-",
      "semanticCommitScope": "{{parentDir}}"
    },
    {
      "description": "One PR bumps the k3s pin everywhere; a merged PR triggers the upgrade, so never automerge",
      "matchDepNames": ["k3s-io/k3s"],
      "groupName": "k3s",
      "additionalBranchPrefix": "",
      "semanticCommitScope": "deps",
      "automerge": false
    },
    {
      "description": "Group GitHub Actions version updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group npm/yarn dependency updates; require 7-day minimum age to guard against supply chain attacks",
      "matchManagers": ["npm"],
      "groupName": "npm-dependencies",
      "minimumReleaseAge": "7 days"
    }
  ]
}
