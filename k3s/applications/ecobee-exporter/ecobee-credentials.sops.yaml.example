# Encrypted SOPS secret. To create from template:
#   cp ecobee-credentials.sops.yaml.example ecobee-credentials.sops.yaml
#   # Edit stringData.appkey with your actual Ecobee Application API Key
#   SOPS_AGE_KEY_FILE=~/.kube/k3s-homelab-age.agekey sops --encrypt --in-place ecobee-credentials.sops.yaml
#   # Then uncomment the reference in kustomization.yaml
#
# The App API Key comes from registering a new app at the Ecobee developer
# portal: https://www.ecobee.com/home/developer/api/menu/homeMenu.jsp
# ("Create New" -> Authorization Method: "Ecobee PIN").
#
# On first pod start, the exporter logs a PIN to stdout. That PIN must be
# entered at https://www.ecobee.com/consumerportal/index.html#/my-apps
# ("Add Application" -> "My Apps" -> enter PIN) within ~9 minutes, or the
# pairing expires and the pod must be restarted to generate a new PIN.
# Watch the logs with:
#   kubectl -n ecobee-exporter logs deploy/ecobee-exporter -f
#
# Once paired, the resulting OAuth tokens are cached to the ecobee-exporter-cache
# PVC (/db/auth.cache) and refreshed automatically — no further manual
# pairing is needed unless that PVC is lost.
apiVersion: v1
kind: Secret
metadata:
  name: ecobee-credentials
  namespace: ecobee-exporter
type: Opaque
stringData:
  appkey: "YOUR_ECOBEE_APP_API_KEY_HERE"
