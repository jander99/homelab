# Encrypted SOPS secret. To create from template:
#   cp ecobee-credentials.sops.yaml.example ecobee-credentials.sops.yaml
#   # Edit stringData.appkey with your actual Ecobee Application API Key
#   SOPS_AGE_KEY_FILE=~/.kube/k3s-homelab-age.agekey sops --encrypt --in-place ecobee-credentials.sops.yaml
#   # Then uncomment the reference in kustomization.yaml
#
# NOTE: the exporter's built-in default demo appkey
# (p3NbLx6iSYTjXDFHIMtM77SWWPLRuEZ0) is dead — Ecobee's /authorize endpoint
# returns 400 invalid_grant for it (verified 2026-08-17). You need your own
# registered app.
#
# The App API Key comes from registering a new app at the Ecobee developer
# portal: https://www.ecobee.com/home/developer/api/menu/homeMenu.jsp
# ("Create New" -> Authorization Method: "Ecobee PIN"). This step does NOT
# require a PIN — you get the API key immediately on submit. The PIN comes
# later, generated by the running exporter using this key.
#
# On first pod start (once this secret exists and the pod is deployed), the
# exporter prints a PIN to stdout, then BLOCKS waiting for <enter> on stdin
# until you've registered it — it will not proceed on its own. Complete
# pairing with:
#   kubectl -n ecobee-exporter logs deploy/ecobee-exporter -f
#   # note the PIN, then register it at:
#   # https://www.ecobee.com/consumerportal/index.html#/my-apps
#   # ("Add Application" -> "My Apps" -> enter PIN) within ~9 minutes
#   kubectl -n ecobee-exporter attach -it deploy/ecobee-exporter
#   # press <enter> in that attached session to unblock the exporter and
#   # complete the token exchange
#
# Once paired, the resulting OAuth tokens are cached to the ecobee-exporter-cache
# PVC (/db/auth.cache) and refreshed automatically — no further manual
# pairing is needed unless that PVC is lost.
apiVersion: v1
kind: Secret
metadata:
  name: ecobee-credentials
  namespace: ecobee-exporter
type: Opaque
stringData:
  appkey: "YOUR_ECOBEE_APP_API_KEY_HERE"
